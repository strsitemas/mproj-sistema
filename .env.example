# Modelo de variáveis; não contém credenciais.
# Desenvolvimento local: preencher em .env.local.
# DATABASE_URL: conexão usada pela aplicação.
# DIRECT_URL: conexão direta usada pelo Prisma CLI.
# SHADOW_DATABASE_URL: banco auxiliar exclusivo das migrações locais.
DATABASE_URL=""
DIRECT_URL=""
SHADOW_DATABASE_URL=""

# Origem da aplicação local
APP_ORIGIN="http://127.0.0.1:3000"

# Gerar uma chave privada de 32 bytes em hexadecimal por ambiente.
LOGIN_RATE_LIMIT_SECRET=""

# Envio de e-mails de recuperação
# Preencher os valores reais somente no ambiente local ou de publicação.
# RESEND_FROM: endereço remetente de um domínio verificado no Resend.
RESEND_API_KEY=""
RESEND_FROM=""
